{
  "$schema": "https://aether-desktop.dev/schema/theme-v1.json",
  "schemaVersion": 1,
  "id": "aether-lavender",
  "name": "AETHER Lavender",
  "author": "AETHER Project",
  "version": "1.0.0",
  "variant": "dark",
  "description": "A warm, dreamy violet atmosphere with rose highlights.",
  "colors": {
    "background": "#120E18",
    "surface": "#191322",
    "surfaceContainer": "#201829",
    "surfaceContainerHigh": "#2A2036",
    "surfaceContainerHighest": "#352A44",
    "onSurface": "#F2EAF7",
    "onSurfaceVariant": "#B4A6C2",
    "outline": "#4A3C59",
    "primary": "#D9B8FF",
    "onPrimary": "#2A1240",
    "primaryContainer": "#43265F",
    "onPrimaryContainer": "#F0DDFF",
    "secondary": "#FFC6E5",
    "onSecondary": "#3A1226",
    "tertiary": "#FFB4C8",
    "error": "#FFB4AB",
    "warning": "#FFD28A",
    "success": "#A8E6B8",
    "glow": "#C79BFF",
    "wallpaperTint": "#1D132A",
    "shadow": "#000000",
