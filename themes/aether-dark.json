{
  "$schema": "https://aether-desktop.dev/schema/theme-v1.json",
  "schemaVersion": 1,
  "id": "aether-dark",
  "name": "AETHER Dark",
  "author": "AETHER Project",
  "version": "1.0.0",
  "variant": "dark",
  "description": "The signature AETHER palette: deep atmosphere, violet aurora, aqua signal.",
  "colors": {
    "background": "#0A0C11",
    "surface": "#12151D",
    "surfaceContainer": "#181C26",
    "surfaceContainerHigh": "#202533",
    "surfaceContainerHighest": "#2A3040",
    "onSurface": "#E8EAF2",
    "onSurfaceVariant": "#A7AEC3",
    "outline": "#394154",
    "primary": "#A99BFF",
    "onPrimary": "#17112E",
    "primaryContainer": "#362B66",
    "onPrimaryContainer": "#E4DEFF",
    "secondary": "#6FE7DD",
    "onSecondary": "#062B28",
    "tertiary": "#FFB4C8",
    "error": "#FFB4AB",
    "warning": "#FFD28A",
    "success": "#8BE3A2",
    "glow": "#8C7BFF",
    "wallpaperTint": "#141827",
    "shadow": "#000000",
    "scrim": "#000000"
  },
  "radii": {
    "xs": 6,
    "sm": 10,
    "md": 16,
    "lg": 22,
    "xl": 28,
    "full": 999
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "typography": {
    "family": "Inter",
    "displayFamily": "Inter Display",
    "monoFamily": "JetBrains Mono",
    "scale": 1.0
  },
  "effects": {
    "blur": true,
    "blurSize": 36,
    "opacity": 0.86,
    "borderOpacity": 0.12,
    "shadow": true,
    "animationScale": 1.0
  }
}
