#!/usr/bin/env python3
"""Open a terminal in a given directory.

Preference order: $TERMINAL, then a list of common Wayland-friendly terminals.
Each terminal gets its own working-directory syntax; no shell is used.
"""
from __future__ import annotations

import os
import shlex
import shutil
import sys

DIRECTORY_FLAGS = {
    "foot": "--working-directory=",
    "kitty": "--directory=",
    "alacritty": "--working-directory=",
    "ghostty": "--working-directory=",
    "konsole": "--workdir=",
    "gnome-terminal": "--working-directory=",
}


def build_command(name: str, directory: str) -> list[str] | None:
    binary = shutil.which(name)
    if binary is None:
        return None
    if name == "wezterm":
        return [binary, "start", "--cwd", directory]
    if name == "xterm":
        return [binary]
    flag = DIRECTORY_FLAGS.get(name)
    if flag is None:
        return None
    return [binary, flag + directory]


def main(argv: list[str]) -> int:
    directory = os.getcwd()
    if "--working-directory" in argv:
        index = argv.index("--working-directory")
        if index + 1 < len(argv):
            directory = os.path.abspath(os.path.expanduser(argv[index + 1]))
    if not os.path.isdir(directory):
        print(f"aether-terminal: not a directory: {directory}", file=sys.stderr)
        return 1

    names: list[str] = []
    env_terminal = os.environ.get("TERMINAL", "").strip()
    if env_terminal:
        try:
            parts = shlex.split(env_terminal)
        except ValueError:
            parts = []
        if parts:
            names.append(parts[0])
    names.extend(["foot", "kitty", "alacritty", "wezterm", "ghostty", "konsole",
                  "gnome-terminal", "xterm"])

    for name in names:
        command = build_command(name, directory)
        if command is None:
            continue
        if name == "xterm":
            os.chdir(directory)
        os.execv(command[0], command)

    print(
        "aether-terminal: no terminal emulator found. Set $TERMINAL or install "
        "foot, kitty, alacritty, wezterm or xterm.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
