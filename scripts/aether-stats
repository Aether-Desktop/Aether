#!/usr/bin/env python3
"""AETHER system statistics collector.

Emits a single JSON object on stdout. Read-only: no subprocess is used unless the
optional `nvidia-smi` binary exists, and it is invoked with an argument list.

This script deliberately avoids shell commands and external Python packages so it can
run on a minimal Arch install.
"""
from __future__ import annotations

import glob
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "aether-stats.json"


def read(path: str) -> str:
    try:
        return Path(path).read_text(errors="replace")
    except OSError:
        return ""


def cpu_times() -> tuple[int, int]:
    line = read("/proc/stat").splitlines()[0] if read("/proc/stat") else ""
    parts = line.split()
    if len(parts) < 5:
        return 0, 0
    values = [int(x) for x in parts[1:] if x.isdigit()]
    idle = values[3] + (values[4] if len(values) > 4 else 0)
    total = sum(values)
    return total, idle


def meminfo() -> dict:
    info: dict[str, int] = {}
    for line in read("/proc/meminfo").splitlines():
        key, _, rest = line.partition(":")
        if not rest:
            continue
        try:
            info[key.strip()] = int(rest.strip().split()[0]) * 1024
        except (ValueError, IndexError):
            continue
    total = info.get("MemTotal", 0)
    avail = info.get("MemAvailable", info.get("MemFree", 0))
    swap_total = info.get("SwapTotal", 0)
    swap_free = info.get("SwapFree", 0)
    return {
        "total": total,
        "used": max(0, total - avail),
        "available": avail,
        "percent": round((1 - avail / total) * 100, 1) if total else 0,
        "swapTotal": swap_total,
        "swapUsed": max(0, swap_total - swap_free),
    }


def loadavg() -> list[float]:
    try:
        return [float(x) for x in read("/proc/loadavg").split()[:3]]
    except ValueError:
        return [0.0, 0.0, 0.0]


def net_bytes() -> tuple[int, int]:
    rx = tx = 0
    for line in read("/proc/net/dev").splitlines()[2:]:
        if ":" not in line:
            continue
        iface, data = line.split(":", 1)
        if iface.strip() == "lo":
            continue
        fields = data.split()
        if len(fields) < 9:
            continue
        try:
            rx += int(fields[0])
            tx += int(fields[8])
        except ValueError:
            continue
    return rx, tx


def network(prev: dict | None, now: float) -> dict:
    rx, tx = net_bytes()
    rate_rx = rate_tx = 0.0
    if prev and prev.get("time") and now > prev["time"]:
        dt = now - prev["time"]
        rate_rx = max(0.0, (rx - prev.get("rx", rx)) / dt)
        rate_tx = max(0.0, (tx - prev.get("tx", tx)) / dt)
    return {"interface": "", "rx": rx, "tx": tx, "rxRate": rate_rx, "txRate": rate_tx}


def disk() -> dict:
    try:
        usage = shutil.disk_usage("/")
        return {
            "total": usage.total,
            "used": usage.used,
            "free": usage.free,
            "percent": round(usage.used / usage.total * 100, 1) if usage.total else 0,
        }
    except OSError:
        return {"total": 0, "used": 0, "free": 0, "percent": 0}


def temperatures() -> list[dict]:
    found: list[dict] = []
    for hwmon in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        name = read(os.path.join(hwmon, "name")).strip() or "sensor"
        for temp in sorted(glob.glob(os.path.join(hwmon, "temp*_input"))):
            try:
                value = int(read(temp).strip()) / 1000.0
            except ValueError:
                continue
            label = read(temp.replace("_input", "_label")).strip() or name
            if -20 < value < 150:
                found.append({"name": label, "value": round(value, 1), "chip": name})
    for zone in sorted(glob.glob("/sys/class/thermal/thermal_zone*")):
        zone_type = read(os.path.join(zone, "type")).strip() or "thermal"
        try:
            value = int(read(os.path.join(zone, "temp")).strip()) / 1000.0
        except ValueError:
            continue
        if -20 < value < 150 and not any(t["name"] == zone_type for t in found):
            found.append({"name": zone_type, "value": round(value, 1), "chip": "thermal"})
    return found


def gpu() -> dict | None:
    # AMD / Intel sysfs (amdgpu, i915 expose gpu_busy_percent on some kernels)
    for path in sorted(glob.glob("/sys/class/drm/card*/device/gpu_busy_percent")):
        try:
            busy = int(read(path).strip())
        except ValueError:
            continue
        mem_used = mem_total = None
        base = os.path.dirname(path)
        try:
            mem_used = int(read(os.path.join(base, "mem_info_vram_used")).strip())
            mem_total = int(read(os.path.join(base, "mem_info_vram_total")).strip())
        except ValueError:
            pass
        return {"vendor": "amd", "utilization": busy, "memoryUsed": mem_used,
                "memoryTotal": mem_total, "temperature": None, "name": "AMD GPU"}
    smi = shutil.which("nvidia-smi")
    if smi:
        try:
            out = subprocess.run(
                [smi, "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
                 "--format=csv,noheader,nounits"],
                capture_output=True, text=True, timeout=2, check=False,
            ).stdout.strip().splitlines()
            if out:
                parts = [p.strip() for p in out[0].split(",")]
                return {
                    "vendor": "nvidia", "name": parts[0],
                    "utilization": int(float(parts[1])) if parts[1] else 0,
                    "memoryUsed": int(float(parts[2])) * 1024 * 1024 if parts[2] else None,
                    "memoryTotal": int(float(parts[3])) * 1024 * 1024 if parts[3] else None,
                    "temperature": float(parts[4]) if parts[4] else None,
                }
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
    return None


def battery() -> dict | None:
    for bat in sorted(glob.glob("/sys/class/power_supply/BAT*")):
        try:
            capacity = int(read(os.path.join(bat, "capacity")).strip())
        except ValueError:
            continue
        status = read(os.path.join(bat, "status")).strip() or "Unknown"
        return {"capacity": capacity, "status": status}
    return None


def main() -> int:
    now = time.time()
    try:
        prev = json.loads(RUNTIME.read_text())
        if not isinstance(prev, dict):
            prev = {}
    except (OSError, ValueError):
        prev = {}

    total, idle = cpu_times()
    prev_total = prev.get("cpuTotal")
    prev_idle = prev.get("cpuIdle")
    usage = 0.0
    if isinstance(prev_total, int) and isinstance(prev_idle, int):
        delta_total = total - prev_total
        delta_idle = idle - prev_idle
        if delta_total > 0:
            usage = round(max(0.0, min(100.0, (1 - delta_idle / delta_total) * 100)), 1)

    net = network(prev.get("net"), now)
    data = {
        "cpu": {"percent": usage, "cores": os.cpu_count() or 0, "load": loadavg()},
        "memory": meminfo(),
        "disk": disk(),
        "network": net,
        "temperatures": temperatures(),
        "gpu": gpu(),
        "battery": battery(),
        "uptime": float(read("/proc/uptime").split()[0]) if read("/proc/uptime") else 0.0,
    }

    try:
        RUNTIME.parent.mkdir(parents=True, exist_ok=True)
        RUNTIME.write_text(json.dumps({"cpuTotal": total, "cpuIdle": idle, "net": net,
                                       "time": now}))
    except OSError:
        pass

    json.dump(data, sys.stdout, separators=(",", ":"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
